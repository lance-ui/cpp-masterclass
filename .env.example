# Public site URL (no trailing slash). Used for OAuth redirect + CORS.
# Local Vite: http://localhost:3000
APP_URL=http://localhost:3000

# Signed session cookie secret (required in production)
SESSION_SECRET=replace-with-a-long-random-string

# Google OAuth 2.0 (optional — app runs without these; Google button is hidden)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth API port (Vite proxies /api → this port in development)
PORT=8787

# --- Real g++ sandbox (/api/run) ---
# auto | docker | bwrap | none
SANDBOX_MODE=auto
# Only for local dev when no Docker/bwrap. NEVER enable in production.
ALLOW_UNSAFE_LOCAL_EXEC=false
# Docker image tag (after: npm run sandbox:build)
SANDBOX_DOCKER_IMAGE=cpp-masterclass-sandbox:local
COMPILE_TIMEOUT_MS=10000
RUN_TIMEOUT_MS=5000
MAX_CODE_BYTES=51200
MAX_STDIN_BYTES=10240
MAX_OUTPUT_BYTES=65536
MAX_CONCURRENT_RUNS=2
RUN_RATE_LIMIT_PER_MINUTE=20
SANDBOX_MEMORY_MB=128
SANDBOX_PIDS_LIMIT=64
