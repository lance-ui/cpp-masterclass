# Minimal g++ image for isolated /api/run jobs.
# Build: npm run sandbox:build   (or ./server/scripts/build-sandbox-image.sh)
FROM debian:bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends g++ ca-certificates bsdutils \
  && rm -rf /var/lib/apt/lists/*
  # bsdutils provides `script` so interactive runs get a PTY (prompt flush)

# Non-root (docker run also passes --user 65534)
USER nobody
WORKDIR /work

# Default: no entrypoint — caller supplies argv (g++ / ./main)
ENTRYPOINT []
CMD ["/bin/true"]
